{
  "name": "nexus-companion",
  "version": "0.8.0",
  "description": "Nexus Interstellar Traffic System — Electron companion with global push-to-talk for in-game play alongside Star Citizen.",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env NEXUS_URL=http://localhost:5173 electron .",
    "start:linux": "electron . --no-sandbox",
    "start:linux:dev": "cross-env NEXUS_URL=http://localhost:5173 electron . --no-sandbox",
    "build": "electron-builder --win",
    "build:all": "electron-builder -mwl"
  },
  "dependencies": {
    "node-global-key-listener": "^0.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "space.nexus-missions.companion",
    "productName": "Nexus Companion",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "build/icon.*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publisherName": "Nexus Interstellar Traffic System"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Companion",
      "uninstallDisplayName": "Nexus Companion — Interstellar Traffic System",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    }
  },
  "license": "GPL-3.0-or-later"
}
