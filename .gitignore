node_modules/
.env
.env.*
backend/uploads/
.DS_Store

# Build output — regenerable, never commit
frontend/dist/
electron/dist/
electron-setup/dist/
electron-setup/payload/nexus-companion.zip
electron-setup/payload/manifest.json

# Published installer binaries live on the server, not in git
backend/releases/*.exe
backend/releases/*.blockmap
backend/releases/latest*.yml
backend/releases/udp.yml

# web-archive/ holds snapshots of previously-deployed frontend dist/.
# Kept on disk as a quick-reference historical record; not useful in
# git since the source for each snapshot is already recoverable from
# the corresponding commit.
web-archive/

# Study / reference material — SRS samples here are GPL v3 and
# MUST NOT ship in the public repo until Nexus itself commits to GPL.
study/

# Source-material archives the user uploaded as references
*.zip

# Loose binaries at repo root (not production assets)
/*.mp3
/*.exe

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
